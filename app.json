{
  "expo": {
    "name": "DietTemple",
    "slug": "diettemple",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/logo.png",
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.diettemple.app",
      "buildNumber": "1",
      "requireFullScreen": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown"
        ]
      }
    },
    "android": {
      "package": "com.diettemple.app",
      "versionCode": 2,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "usesCleartextTraffic": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-secure-store",
      "./plugins/withRemoveBackgroundAudio",
      [
        "expo-video",
        {
          "supportsPictureInPicture": true,
          "supportsBackgroundPlayback": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "DietTemple a besoin de votre caméra pour scanner vos repas et vérifier votre présence en salle.",
          "microphonePermission": "DietTemple a besoin du microphone pour les vidéos d'entraînement."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "DietTemple utilise l'appareil photo uniquement lorsque vous choisissez de photographier un repas pour l'analyse nutritionnelle.",
          "photosPermission": "DietTemple vous permet de sélectionner une photo de repas pour l'analyse nutritionnelle.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "diettemple",
    "extra": {
      "eas": {
        "projectId": "6aa5dbbd-f221-4856-b8d7-1fad8d780a8f"
      }
    }
  }
}
